# ─── Substrate WebSocket RPCs ────────────────────────────────────────────────
# Polkadot Hub substrate node (Westend testnet)
POLKADOT_HUB_WS_RPC=wss://westend-rpc.polkadot.io

# Asset Hub substrate node (Westend testnet)
ASSET_HUB_WS_RPC=wss://westend-asset-hub-rpc.polkadot.io

# ─── Polkadot Hub EVM / ETH-RPC  ─────────────────────────────────────────────
# Used by ethers.js to send contract transactions
# Polkadot Hub TestNet ETH-RPC
ETH_RPC_URL=https://services.polkadothub-rpc.com/testnet

# ─── Indexer Wallet (signs recordTransaction calls) ──────────────────────────
# Private key of a funded account on Polkadot Hub EVM.
# IMPORTANT: This account MUST be the owner of the deployed ParaTraceRegistry
# contract (recordTransaction has an onlyOwner modifier). Transfer ownership
# to this account after deployment if needed.
# Never commit a real private key — use a testnet key here.
INDEXER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── ParaTraceRegistry Contract ──────────────────────────────────────────────
# Deployed address of ParaTraceRegistry.sol on Polkadot Hub
REGISTRY_CONTRACT_ADDRESS=0xYOUR_REGISTRY_CONTRACT_ADDRESS

# ─── Optional tuning ─────────────────────────────────────────────────────────
# Minimum token amount (in planck / smallest unit) before indexer reports
# Set to 0 to capture all transfers
MIN_TRANSFER_AMOUNT=0

# Log level: error | warn | info | debug
LOG_LEVEL=info
