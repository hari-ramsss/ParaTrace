# ─────────────────────────────────────────────────────────────────────────────
# ParaTrace Indexer – Environment Configuration
# Copy this file to .env and fill in the values before running the indexer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Substrate WebSocket RPC Endpoints ────────────────────────────────────────
# Polkadot Hub (Paseo TestNet)
POLKADOT_HUB_WS=wss://paseo.dotters.network

# Asset Hub (Paseo TestNet)
ASSET_HUB_WS=wss://asset-hub-paseo-rpc.dwellir.com

# ── ETH-compatible JSON-RPC for Polkadot Hub (pallet-revive / PVM) ───────────
# Used by ethers.js to call the deployed ParaTraceRegistry Solidity contract.
# If running the local dev node from contracts-solidity/bin, use:
#   ETH_RPC_URL=http://127.0.0.1:8545
ETH_RPC_URL=http://127.0.0.1:8545

# ── Deployed Contract Addresses ──────────────────────────────────────────────
# Address of the deployed ParaTraceRegistry contract on Polkadot Hub
REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Signer Key (for sending transactions to the Registry) ────────────────────
# Private key of the account that will call processWalletAudit().
# NEVER commit a real private key here – use a funded test account.
SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Indexer Settings ─────────────────────────────────────────────────────────
# Minimum transfer amount (in planck/lowest denomination) to process.
# Transfers below this threshold are ignored.
MIN_TRANSFER_AMOUNT=1000000000

# Risk score threshold above which a wallet is considered flagged.
RISK_SCORE_THRESHOLD=75

# How many blocks to look back on startup (0 = start from latest block only)
BACKFILL_BLOCKS=0

# Log level: error | warn | info | debug
LOG_LEVEL=info
