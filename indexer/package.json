{
  "name": "paratrace-indexer",
  "version": "1.0.0",
  "description": "XCM Event Indexer for ParaTrace – subscribes to XCM transfer events on Polkadot Hub and Asset Hub, then calls the Solidity Registry for each detected cross-chain transfer.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "keywords": [
    "polkadot",
    "xcm",
    "indexer",
    "paratrace",
    "cross-chain",
    "substrate"
  ],
  "author": "ParaTrace",
  "license": "MIT",
  "dependencies": {
    "@polkadot/api": "^15.10.2",
    "@polkadot/keyring": "^13.3.1",
    "@polkadot/util": "^13.3.1",
    "@polkadot/util-crypto": "^13.3.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
